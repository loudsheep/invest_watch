# Copy to .env and adjust. Secrets live only here - never commit a real .env.

# --- LLM inference (ADR-0002) ---
# Any OpenAI-compatible endpoint. Default: OpenRouter (needs LLM_API_KEY).
# Local alternative: `docker compose --profile ollama up -d ollama`, then
#   LLM_BASE_URL=http://ollama:11434/v1  (or http://host.docker.internal:11434/v1
#   for native Ollama on the host, Metal-accelerated), LLM_API_KEY empty,
#   LLM_MODEL=gemma3:4b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-3-12b-it

# --- Auth (ADR-0016) ---
# Generate a real secret for anything beyond local dev: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production

# --- Evidence storage (Garage, S3-compatible - see garage/init.sh) ---
# Defaults match garage/init.sh's dev key; change both together if you touch either.
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=investwatch-evidence

# --- Scraping (ADR-0015) ---
# Comma-separated proxy URLs, e.g. http://proxy-1:8118,http://proxy-2:8118
# Empty = direct connection (default, safe for local dev).
PROXY_URLS=

# --- RODO retention (ADR-0019) ---
RETENTION_DAYS_NO_FINDING=30

# --- Classifier thresholds (overridable live from the Kalibracja panel;
# these are just the startup defaults) ---
CLASSIFIER_THRESHOLD_M1=0.5
CLASSIFIER_THRESHOLD_M2=0.5
CLASSIFIER_THRESHOLD_M3=0.5
