# Copy to .env and adjust. Secrets live only here - never commit a real .env.
# The values below are local-development placeholders. For anything beyond a local
# demo replace every secret, e.g. with: openssl rand -hex 32

# --- Database and queue ---
POSTGRES_PASSWORD=investwatch-dev
# Used inside a redis:// URL, so keep it URL-safe (hex is fine).
REDIS_PASSWORD=investwatch-dev-redis

# --- LLM inference (ADR-0002) ---
# Any OpenAI-compatible endpoint. Default: Ollama in compose (CPU), model pulled
# automatically by `ollama-init`. For Metal acceleration on macOS run Ollama
# natively and set LLM_BASE_URL=http://host.docker.internal:11434/v1.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=gemma3:4b

# --- Auth (ADR-0016) ---
JWT_SECRET=dev-secret-change-in-production
# Seeded dashboard accounts `analyst` and `admin` (used only when the database is created).
ANALYST_PASSWORD=changeme-dev
ADMIN_PASSWORD=changeme-dev
# Origins allowed to call the API and open the Socket.io connection.
CORS_ORIGINS=http://localhost:47173,http://localhost:5173

# --- Evidence storage (Garage, S3-compatible - see garage/init.sh) ---
# Access key: "GK" + 24 hex chars. Secret key and RPC secret: 64 hex chars.
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=investwatch-evidence
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=investwatch-dev-admin-token

# --- Discovery (SearXNG) ---
SEARXNG_SECRET=investwatch-dev-searxng-secret-change-me

# --- Scraping (ADR-0015) ---
# Comma-separated proxy URLs, e.g. http://proxy-1:8118,http://proxy-2:8118
# Empty = direct connection (default, safe for local dev).
PROXY_URLS=
# Private-network hosts the crawler may fetch; everything else must resolve to a
# public address (SSRF guard).
FETCH_ALLOWED_PRIVATE_HOSTS=demo-sites,nordik-brokr-demo.local

# --- RODO retention (ADR-0019) ---
RETENTION_DAYS_NO_FINDING=30

# --- Classifier thresholds (overridable live from the Kalibracja panel;
# these are just the startup defaults) ---
CLASSIFIER_THRESHOLD_M1=0.5
CLASSIFIER_THRESHOLD_M2=0.5
CLASSIFIER_THRESHOLD_M3=0.5
